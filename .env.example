# ==============================================================================
# WeatherPulse React Frontend — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and adjust the values as needed.
# Note: In Vite, only variables prefixed with VITE_ are exposed to client code.

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Frontend Auto-Refresh Polling Interval (in seconds)
VITE_AUTO_REFRESH_SECONDS=60

# Feature Flag: Enable lightweight 3D weather icons (falls back to SVG if WebGL is unavailable)
VITE_ENABLE_3D_ICONS=true
